# Supabase project the browser talks to. Both values are safe to expose to the
# client (the anon key is scoped by RLS) but must never be committed.
#
# Local stack (after `npm run db:start`, values from `npx supabase status`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<anon key printed by supabase status>
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
